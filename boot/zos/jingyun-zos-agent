    identity_dns=$(jq -r '(.task.identity_dns // []) | join(",")' <<<"$CLAIM_RESPONSE")
    [[ "$identity_name_enabled" == "true" ]] || identity_name=""
    if [[ "$identity_network_mode" != "static" ]]; then
        identity_ip=""
        identity_gateway=""
        identity_dns=""
    fi
    if [[ "$identity_name_enabled" == "true" ||
          "$identity_network_mode" == "static" ||
          "$identity_network_mode" == "dhcp" ]]; then
        identity_enabled=true
    else
        identity_enabled=false
    fi

    requested_device=$(jq -r '.task.device // "auto"' <<<"$CLAIM_RESPONSE")
    image_name=$(jq -r '.task.image_name // "image"' <<<"$CLAIM_RESPONSE")
    image_type=$(jq -r '.task.image_type // empty' <<<"$CLAIM_RESPONSE")
    source_bytes=$(jq -r '.task.source_bytes // 0' <<<"$CLAIM_RESPONSE")
    [[ "$image_type" == "raw_disk" ]] || {
        report_failure "Deploy supports RAW whole-disk images only"
        return 1
    }
    [[ "$source_bytes" =~ ^[0-9]+$ && "$source_bytes" -gt 0 ]] || {
        report_failure "Image source size is invalid"
        return 1
    }
    [[ "$transfer_mode" == "unicast" || "$transfer_mode" == "multicast" ]] || {
        report_failure "Unsupported deploy transfer mode: ${transfer_mode}"
        return 1
    }
    if [[ "$transfer_mode" == "multicast" ]] &&        ! command -v udp-receiver >/dev/null 2>&1 &&        ! command -v zosmc-receiver >/dev/null 2>&1; then
        report_failure "ZOS environment has no reliable multicast receiver"
        return 1
    fi
    case "$multicast_profile" in
        compatible) rcvbuf=4194304 ;;
        maximum) rcvbuf=16777216 ;;
        *) multicast_profile="gigabit"; rcvbuf=8388608 ;;
    esac

    device=$(detect_disk "$requested_device" "$source_bytes")
    [[ "$device" =~ ^/dev/[A-Za-z0-9._/+:-]+$ && "$device" != *".."* && -b "$device" ]] || {
        lsblk -b -o NAME,PATH,TYPE,SIZE,RO,RM,FSTYPE 2>/dev/null || true
        report_failure "No usable target disk was detected (requested: ${requested_device})"
        return 1
    }
    target_bytes=$(blockdev --getsize64 "$device" 2>/dev/null)
    [[ "${target_bytes:-0}" -ge "$source_bytes" ]] || {
        report_failure "Target ${device} is smaller than the source disk (${target_bytes:-0} < ${source_bytes})"
        return 1
    }

    echo "[2/5] Task ${TASK_ID}, image ${image_name}"
    echo "Target disk: ${device} (${target_bytes} bytes)"
    echo "Transfer: $([[ "$transfer_mode" == "multicast" ]] && echo "reliable multicast" || echo "individual TCP")"
    if [[ "$identity_enabled" == "true" ]]; then
        [[ "$identity_name_enabled" == "true" ]] &&
            echo "Post-deploy computer name: ${identity_name}" ||
            echo "Post-deploy computer name: preserve image setting"
        [[ "$identity_network_mode" == "static" ]] &&
            echo "Post-deploy IPv4: ${identity_ip}/${identity_prefix}, gateway=${identity_gateway:-none}, DNS=${identity_dns:-none}" ||
            {
                [[ "$identity_network_mode" == "dhcp" ]] &&
                    echo "Post-deploy IPv4: DHCP automatic" ||
                    echo "Post-deploy IPv4: preserve image setting"
            }
    fi
    echo "WARNING: all partitions and data on ${device} will be overwritten."
    for count in 5 4 3 2 1; do
        echo "Writing starts in ${count}..."
        sleep 1
    done

    if [[ "$transfer_mode" == "multicast" ]]; then
        echo "[3/5] Target disk is ready. Waiting for every group client..."
        ready_payload=$(jq -nc --arg token "$TOKEN" --arg task_id "$TASK_ID" --arg mac "$MAC" \
            '{op:"multicast_ready",token:$token,task_id:$task_id,mac:$mac}')
        response=$(tcp_json "$ready_payload") || {
            report_failure "Cannot report multicast readiness"
            return 1
        }
        while true; do
            [[ $(jq -r '.ok // false' <<<"$response") == "true" ]] || {
                report_failure "$(jq -r '.error // "Manager rejected multicast readiness"' <<<"$response")"
                return 1
            }
            multicast_state=$(jq -r '.state // "waiting"' <<<"$response")
            ready_count=$(jq -r '.ready_count // 0' <<<"$response")
            expected=$(jq -r '.expected // 0' <<<"$response")
            multicast_protocol=$(jq -r '.protocol // "udpcast"' <<<"$response")
            printf '\rMulticast group ready: %s/%s; state=%s; protocol=%s   ' \
                "$ready_count" "$expected" "$multicast_state" "$multicast_protocol"
            if [[ "$multicast_state" == "failed" || "$multicast_state" == "cancelled" ]]; then
                printf '\n'
                report_failure "Multicast session ${multicast_state}"
                return 1
            fi
            if [[ "$multicast_state" == "running" || "$multicast_state" == "sent" ||
                  ( "$multicast_state" == "starting" && "$multicast_protocol" == "zosmc1" ) ]]; then
                printf '\n'
                portbase=$(jq -r '.portbase // 0' <<<"$response")
                multicast_session_id=$(jq -r '.session_id // empty' <<<"$response")
                break
            fi
            sleep 2
            status_payload=$(jq -nc --arg token "$TOKEN" --arg task_id "$TASK_ID" --arg mac "$MAC" \
                '{op:"multicast_status",token:$token,task_id:$task_id,mac:$mac}')
            response=$(tcp_json "$status_payload") || {
                report_failure "Cannot query multicast session"
                return 1
            }
        done
        [[ "$portbase" =~ ^[0-9]+$ && "$portbase" -ge 1024 ]] || {
            report_failure "Manager returned an invalid multicast port"
            return 1
        }
        echo "All clients are ready. Receiving one reliable multicast stream..."
        notify_deploy_started || {
            report_failure "Manager rejected deploy start"
            return 1
        }
        start_progress_reporter "$source_bytes"
        if [[ "$multicast_protocol" == "zosmc1" ]]; then
            [[ -n "$multicast_session_id" ]] || {
                report_failure "Manager returned no ZOS multicast session id"
                return 1
            }
            command -v zosmc-receiver >/dev/null 2>&1 || {
                report_failure "ZOSMC receiver is missing from this PXE environment"
                return 1
            }
            zosmc-receiver \
                --session-id "$multicast_session_id" \
                --server-ip "$SERVER" \
                --interface-ip "$CLIENT_IP" \
                --port "$portbase" \
                --mac "$MAC" \
                --receive-timeout 180 |
                zstd -d -c |
                dd of="$device" bs=8M conv=fsync status=progress \
                    2>"$PROGRESS_STATUS_FILE"
        else
            udp-receiver \
                --interface "$CLIENT_IFACE" \
                --mcast-rdv-address "$SERVER" \
                --portbase "$portbase" \
                --rcvbuf "$rcvbuf" \
                --nokbd \
                --start-timeout 900 \
                --receive-timeout 120 |
                zstd -d -c |
                dd of="$device" bs=8M conv=fsync status=progress \
                    2>"$PROGRESS_STATUS_FILE"
        fi
        transfer_status=("${PIPESTATUS[@]}")
        request_rc=0
        transport_rc=${transfer_status[0]:-255}
        decoder_rc=${transfer_status[1]:-255}
        writer_rc=${transfer_status[2]:-255}
    else
        header=$(jq -nc --arg token "$TOKEN" --arg task_id "$TASK_ID" --arg mac "$MAC" \
            '{op:"download",token:$token,task_id:$task_id,mac:$mac}')
        echo "[3/5] Downloading, decompressing and writing the disk..."
        notify_deploy_started || {
            report_failure "Manager rejected deploy start"
            return 1
        }
        start_progress_reporter "$source_bytes"
        printf '%s\n' "$header" |
            socat "STDIO,ignoreeof" "TCP:${SERVER}:${PORT},connect-timeout=10" |
            zstd -d -c |
            dd of="$device" bs=8M conv=fsync status=progress \
                2>"$PROGRESS_STATUS_FILE"
        transfer_status=("${PIPESTATUS[@]}")
        request_rc=${transfer_status[0]:-255}
        transport_rc=${transfer_status[1]:-255}
        decoder_rc=${transfer_status[2]:-255}
        writer_rc=${transfer_status[3]:-255}
    fi

    # dd wrote progress to a regular file, so parsing cannot break the data pipe.
    sleep 1
    refresh_written_progress
    written_bytes=$(read_written_progress)
    if deploy_pipeline_complete \
        "$source_bytes" "$written_bytes" "$request_rc" \
        "$transport_rc" "$decoder_rc" "$writer_rc"; then
        download_rc=0
    else
        download_rc=1
    fi

    # End the single-line progress display before printing any normal log line.
    [[ $download_rc -eq 0 ]] && stop_progress_reporter 1 "$source_bytes" ||
        stop_progress_reporter 0 "$source_bytes"
    if [[ $download_rc -eq 0 && "$transport_rc" -eq 141 ]]; then
        echo "NOTICE: transport closed with SIGPIPE after the complete zstd frame was written."
        echo "        Exact disk bytes were verified; continuing as a successful deployment."
    fi
    echo "Transfer req=${request_rc} net=${transport_rc} zstd=${decoder_rc} dd=${writer_rc} bytes=${written_bytes}/${source_bytes}"
    [[ $download_rc -eq 0 ]] || {
        report_failure "Write failed req=${request_rc} net=${transport_rc} zstd=${decoder_rc} dd=${writer_rc} bytes=${written_bytes}/${source_bytes}"
        return 1
    }

    echo "[4/5] Flushing disk data..."
    sync
    blockdev --rereadpt "$device" >/dev/null 2>&1 || true
    if [[ "$identity_enabled" == "true" ]]; then
        echo "Applying selected post-deploy computer name/network options..."
        if apply_deployed_identity \
            "$device" "$identity_name" "$identity_ip" "$identity_prefix" \
            "$identity_gateway" "$identity_dns" "$MAC" "$identity_network_mode"; then
            identity_ok=true
            identity_message="$IDENTITY_MESSAGE"
            echo "Identity configuration scheduled: ${identity_message}"
        else
            identity_ok=false
            identity_message="$IDENTITY_MESSAGE"
            echo "WARNING: image writing succeeded, but identity configuration failed: ${identity_message}"
        fi
    fi
    complete=$(jq -nc --arg token "$TOKEN" --arg task_id "$TASK_ID" --arg mac "$MAC" \
        --argjson identity_ok "$identity_ok" --arg identity_message "$identity_message" \
        '{op:"complete",token:$token,task_id:$task_id,mac:$mac,
          identity_ok:$identity_ok,identity_message:$identity_message}')
    response=$(tcp_json "$complete") || {
        report_failure "Disk was written, but completion could not be reported"
        return 1
    }
    [[ $(jq -r '.ok // false' <<<"$response") == "true" ]] || {
        report_failure "$(jq -r '.error // "Manager rejected completion"' <<<"$response")"
        return 1
    }
    echo "[5/5] Image deployment completed"
    echo "You may reboot and boot from the local disk."
    echo "------------------------------------------------------------"
    perform_post_action "$post_action"
}

if [[ "${ZOS_AGENT_LIBRARY_ONLY:-0}" == "1" ]]; then
    return 0 2>/dev/null || exit 0
fi

banner
validate_common || exit 1
case "$MODE" in
    register) register_main ;;
    capture) capture_main ;;
    deploy) deploy_main ;;
    *) echo "No Jingyun imaging mode requested." ;;
esac
exit $?

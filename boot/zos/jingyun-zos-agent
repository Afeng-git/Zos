install_windows_identity_direct() {
    local part="$1" name="$2" address="$3" prefix="$4"
    local gateway="$5" dns="$6" target_mac="$7"
    local network_mode="${8:-}"
    [[ -n "$network_mode" ]] ||
        network_mode=$([[ -n "$address" ]] && echo static || echo unchanged)
    local direct_root="/tmp/zos-early-direct-${TASK_ID}"
    local local_system local_software local_verify local_cmd local_ps1 startup_local
    local verify_reg="" needs_network=0 install_rc=0 fallback_staged=0
    local install_message=""

    command -v ntfscat >/dev/null 2>&1 || {
        IDENTITY_MESSAGE="ZOS environment has no ntfscat"
        return 1
    }
    command -v ntfscp >/dev/null 2>&1 || {
        IDENTITY_MESSAGE="ZOS environment has no ntfscp"
        return 1
    }
    rm -rf "$direct_root"
    mkdir -p \
        "$direct_root/Windows/System32/config" \
        "$direct_root/Windows/Temp" \
        "$direct_root/ProgramData/Microsoft/Windows/Start Menu/Programs/Startup"
    local_system="$direct_root/Windows/System32/config/SYSTEM"
    local_software="$direct_root/Windows/System32/config/SOFTWARE"
    local_verify="$direct_root/Windows/System32/config/SYSTEM.verify"

    if ! ntfscat -f "$part" /Windows/System32/config/SYSTEM \
        >"$local_system" 2>/tmp/zos-early-direct.log; then
        IDENTITY_MESSAGE="${part} is not the Windows 7+ system partition"
        return 1
    fi
    if [[ "$network_mode" != "unchanged" ]] &&
        ntfscat -f "$part" /Windows/System32/config/SOFTWARE \
        >"$local_software" 2>/tmp/zos-early-direct.log; then
        needs_network=1
    fi
    install_windows_identity \
        "$direct_root" "$name" "$address" "$prefix" "$gateway" "$dns" \
        "$target_mac" "$network_mode" ||
        install_rc=$?
    install_message="$IDENTITY_MESSAGE"
    if [[ -s "$direct_root/Windows/Temp/ZOSApplyNetwork.cmd" &&
          -s "$direct_root/Windows/Temp/ZOSApplyNetwork.ps1" ]]; then
        fallback_staged=1
    fi
    if ! ntfscp -f "$part" "$local_system" /Windows/System32/config/SYSTEM \
        >/tmp/zos-early-direct.log 2>&1; then
        IDENTITY_MESSAGE="Cannot write modified Windows SYSTEM hive: $(tail -n 1 /tmp/zos-early-direct.log)"
        return 1
    fi
    if [[ "$fallback_staged" == "1" && "$needs_network" == "1" &&
          -s "$local_software" ]]; then
        local_cmd="$direct_root/Windows/Temp/ZOSApplyNetwork.cmd"
        local_ps1="$direct_root/Windows/Temp/ZOSApplyNetwork.ps1"
        startup_local="$direct_root/ProgramData/Microsoft/Windows/Start Menu/Programs/Startup/ZOSApplyNetwork.cmd"
        ntfscp -f "$part" "$local_cmd" /Windows/Temp/ZOSApplyNetwork.cmd \
            >/tmp/zos-early-direct.log 2>&1 || {
            IDENTITY_MESSAGE="Computer name written, but cannot write one-time network CMD"
            return 1
        }
        ntfscp -f "$part" "$local_ps1" /Windows/Temp/ZOSApplyNetwork.ps1 \
            >/tmp/zos-early-direct.log 2>&1 || {
            IDENTITY_MESSAGE="Computer name written, but cannot write one-time network PowerShell"
            return 1
        }
        ntfscp -f "$part" "$startup_local" \
            "/ProgramData/Microsoft/Windows/Start Menu/Programs/Startup/ZOSApplyNetwork.cmd" \
            >/tmp/zos-early-direct-startup.log 2>&1 || true
        ntfscp -f "$part" "$local_software" /Windows/System32/config/SOFTWARE \
            >/tmp/zos-early-direct.log 2>&1 || {
            IDENTITY_MESSAGE="Computer name written, but cannot write modified SOFTWARE hive"
            return 1
        }
    fi

    if ! ntfscat -f "$part" /Windows/System32/config/SYSTEM \
        >"$local_verify" 2>/tmp/zos-early-direct-verify.log; then
        IDENTITY_MESSAGE="Cannot read back the modified Windows SYSTEM hive"
        return 1
    fi
    if [[ -n "$name" ]]; then
        verify_reg="/tmp/zos-early-direct-name-${TASK_ID}.reg"
        rm -f "$verify_reg"
        reged -x "$local_verify" 'HKEY_LOCAL_MACHINE\SYSTEM' \
            '\ControlSet001\Control\ComputerName\ComputerName' "$verify_reg" \
            >/tmp/zos-early-direct-verify.log 2>&1 || true
        grep -Fq "\"ComputerName\"=\"${name}\"" "$verify_reg" || {
            IDENTITY_MESSAGE="Direct NTFS read-back did not contain computer name ${name}"
            return 1
        }
    fi
    sync
    if [[ "$network_mode" != "unchanged" ]]; then
        if [[ "$install_rc" != "0" ]]; then
            IDENTITY_MESSAGE="$install_message"
            return 1
        fi
        if [[ "$fallback_staged" == "1" ]]; then
            if [[ "$needs_network" != "1" || ! -s "$local_software" ]]; then
                IDENTITY_MESSAGE="Computer name ${name} was verified offline, but the one-time static IP fallback could not be written"
                return 1
            fi
            if [[ -n "$name" ]]; then
                IDENTITY_MESSAGE="Windows 7+ computer name verified offline; one-time ${network_mode} IPv4 action written directly"
            else
                IDENTITY_MESSAGE="Windows computer name preserved; one-time ${network_mode} IPv4 action written directly"
            fi
        else
            IDENTITY_MESSAGE="$install_message"
        fi
    else
        IDENTITY_MESSAGE="Windows 7+ computer name verified using ZOS early offline personalization; network configuration preserved"
    fi
    return 0
}

mount_windows_partition_rw() {
    local part="$1" mountpoint="$2" ntfs_tool=""
    : > /tmp/zos-ntfs-mount.log

    # ntfs-3g is a userspace FUSE program, not a kernel filesystem name.
    # BusyBox mount -t ntfs-3g returns ENODEV ("No such device"), so invoke
    # the program directly after preparing FUSE.
    modprobe fuse >/dev/null 2>&1 || true
    if [[ ! -c /dev/fuse ]] && command -v mknod >/dev/null 2>&1; then
        mknod /dev/fuse c 10 229 >/dev/null 2>&1 || true
        chmod 0666 /dev/fuse >/dev/null 2>&1 || true
    fi
    ntfs_tool=$(command -v ntfs-3g 2>/dev/null || true)
    if [[ -n "$ntfs_tool" ]]; then
        if "$ntfs_tool" -o rw "$part" "$mountpoint" \
            >/tmp/zos-ntfs-mount.log 2>&1; then
            return 0
        fi
        # A cloned Windows Fast Startup/hibernation state is stale on the new
        # hardware. Discard it and retry so offline personalization can proceed.
        if "$ntfs_tool" -o rw,remove_hiberfile "$part" "$mountpoint" \
            >/tmp/zos-ntfs-mount.log 2>&1; then
            return 0
        fi
    fi

    # Fallback for kernels that provide the in-kernel NTFS3 driver but do not
    # provide usable FUSE support.
    modprobe ntfs3 >/dev/null 2>&1 || true
    if grep -qw ntfs3 /proc/filesystems 2>/dev/null; then
        if mount -t ntfs3 -o rw "$part" "$mountpoint" \
            >/tmp/zos-ntfs-mount.log 2>&1; then
            return 0
        fi
    fi
    return 1
}

apply_deployed_identity() {
    local disk="$1" name="$2" address="$3" prefix="$4"
    local gateway="$5" dns="$6" target_mac="$7"
    local network_mode="${8:-}"
    [[ -n "$network_mode" ]] ||
        network_mode=$([[ -n "$address" ]] && echo static || echo unchanged)
    local mountpoint="/mnt/zos-target" part fstype linux_root result
    local -a mount_prefix=()
    local last_error=""
    IDENTITY_MESSAGE=""
    mkdir -p "$mountpoint"
    command -v timeout >/dev/null 2>&1 && mount_prefix=(timeout 20)
    partprobe "$disk" >/dev/null 2>&1 || true
    udevadm settle >/dev/null 2>&1 || true
    modprobe dm_mod >/dev/null 2>&1 || true
    if command -v lvm >/dev/null 2>&1; then
        "${mount_prefix[@]}" lvm pvscan --cache >/tmp/zos-pvscan.log 2>&1 || true
        "${mount_prefix[@]}" lvm vgscan --mknodes >/tmp/zos-vgscan.log 2>&1 || true
    fi
    command -v dmsetup >/dev/null 2>&1 && dmsetup mknodes >/dev/null 2>&1 || true
    if command -v vgchange >/dev/null 2>&1; then
        "${mount_prefix[@]}" vgchange -ay >/tmp/zos-vgchange.log 2>&1 || true
    elif command -v lvm >/dev/null 2>&1; then
        "${mount_prefix[@]}" lvm vgchange -ay >/tmp/zos-vgchange.log 2>&1 || true
    fi
    udevadm settle >/dev/null 2>&1 || true
    # Deepin 25 Solid does not boot directly from the OSTree deployment tree.
    # /etc, /usr and /opt are composed from persistent upper modification layers.
    # Write identity into those active/lower upperdirs before using the generic path.
    if apply_deepin_solid_identity         "$disk" "$name" "$address" "$prefix" "$gateway" "$dns"         "$target_mac" "$network_mode"; then
        return 0
    fi
    while read -r part; do
        [[ -b "$part" ]] || continue
        "${mount_prefix[@]}" umount -l "$mountpoint" >/dev/null 2>&1 || true
        fstype=$(blkid -o value -s TYPE "$part" 2>/dev/null)
        case "$fstype" in
            ntfs|ntfs3)
                if ! mount_windows_partition_rw "$part" "$mountpoint"; then
                    if install_windows_identity_direct \
                        "$part" "$name" "$address" "$prefix" "$gateway" "$dns" \
                        "$target_mac" "$network_mode"; then
                        return 0
                    fi
                    last_error="$IDENTITY_MESSAGE"
                    continue
                fi
                if [[ -d "$mountpoint/Windows" || -d "$mountpoint/WINDOWS" ]]; then
                    install_windows_identity \
                        "$mountpoint" "$name" "$address" "$prefix" "$gateway" "$dns" \
                        "$target_mac" "$network_mode"
                    result=$?
                    "${mount_prefix[@]}" umount -l "$mountpoint" >/dev/null 2>&1 || true
                    return "$result"
                fi
                ;;
            ext2|ext3|ext4|xfs|btrfs)
                if [[ "$fstype" == "xfs" ]]; then
                    "${mount_prefix[@]}" mount -t xfs -o rw,nouuid "$part" "$mountpoint" \
                        >/tmp/zos-mount.log 2>&1 || {
                        last_error="Cannot mount Kylin/XFS root ${part}: $(tail -n 1 /tmp/zos-mount.log)"
                        continue
                    }
                else
                    "${mount_prefix[@]}" mount -o rw "$part" "$mountpoint" \
                        >/tmp/zos-mount.log 2>&1 || {
                        last_error="Cannot mount Linux root candidate ${part}: $(tail -n 1 /tmp/zos-mount.log)"
                        continue
                    }
                fi
                result=1
                local applied=0 candidate_root
                for candidate_root in \
                    "$mountpoint" "$mountpoint/@" "$mountpoint/rootfs" "$mountpoint/sysroot" \
                    "$mountpoint"/ostree/deploy/*/deploy/*.0 \
                    "$mountpoint"/sysroot/ostree/deploy/*/deploy/*.0 \
                    "$mountpoint"/rootfs/ostree/deploy/*/deploy/*.0; do
                    [[ -d "$candidate_root" ]] || continue
                    if [[ -e "$candidate_root/usr/lib/os-release" ||
                          -e "$candidate_root/etc/os-release" ||
                          -L "$candidate_root/etc/os-release" ]]; then
                        if install_linux_identity \
                            "$candidate_root" "$name" "$address" "$prefix" "$gateway" "$dns" \
                            "$target_mac" "$network_mode"; then
                            applied=$((applied + 1))
                            result=0
                        else
                            last_error="$IDENTITY_MESSAGE"
                        fi
                    fi
                done
                if (( applied > 0 )); then
                    (( applied > 1 )) && IDENTITY_MESSAGE="Linux identity written to ${applied} OSTree deployments; ${IDENTITY_MESSAGE}"
                    "${mount_prefix[@]}" umount -l "$mountpoint" >/dev/null 2>&1 || true
                    return 0
                fi
                ;;
        esac
        "${mount_prefix[@]}" umount -l "$mountpoint" >/dev/null 2>&1 || true
    done < <(lsblk -lnpo NAME,TYPE "$disk" 2>/dev/null | awk '$2=="part" || $2=="lvm" {print $1}')
    IDENTITY_MESSAGE="${last_error:-No supported Windows or Linux system partition was found}"
    return 1
}

capture_main() {
    local requested_device device image_type filesystem source_bytes source_arch
    local header response upload_rc partclone_bin device_kind post_action

    echo "[1/4] Connecting to ${SERVER}:${PORT}..."
    claim_task capture || return 1
    TASK_ID=$(jq -r '.task.id // empty' <<<"$CLAIM_RESPONSE")
    [[ -n "$TASK_ID" ]] || {
        echo "No queued upload task. Create a task on the manager first."
        return 0
    }
    post_action=$(jq -r '.task.post_action // "none"' <<<"$CLAIM_RESPONSE")

    device=$(jq -r '.task.device // "auto"' <<<"$CLAIM_RESPONSE")
    image_type=$(jq -r '.task.image_type // empty' <<<"$CLAIM_RESPONSE")
    filesystem=$(jq -r '.task.filesystem // "auto"' <<<"$CLAIM_RESPONSE")
    requested_device="$device"
    device=$(detect_disk "$requested_device")
    if [[ -n "$device" && "$device" != "$requested_device" ]]; then
        echo "Requested source ${requested_device} is unavailable; detected ${device}"
    fi
    [[ "$device" =~ ^/dev/[A-Za-z0-9._/+:-]+$ && "$device" != *".."* ]] || {
        lsblk -b -o NAME,PATH,TYPE,SIZE,RO,RM,FSTYPE 2>/dev/null || true
        report_failure "No usable source disk was detected (requested: ${requested_device})"
        return 1
    }
    [[ -b "$device" ]] || {
        report_failure "Detected source device does not exist: ${device}"
        return 1
    }
    [[ "$image_type" == "raw_disk" || "$image_type" == "partclone_partition" ]] || {
        report_failure "Unsupported image type: ${image_type}"
        return 1
    }
    if [[ "$image_type" == "partclone_partition" ]]; then
        device_kind=$(lsblk -dnpo TYPE "$device" 2>/dev/null | awk 'NR==1 {print $1}')
        if [[ "$device_kind" == "disk" ]]; then
            echo "Whole disk ${device} selected; switching from Partclone partition mode to RAW disk image."
            image_type="raw_disk"
        else
            if [[ "$filesystem" == "auto" || -z "$filesystem" ]]; then
                filesystem=$(blkid -o value -s TYPE "$device" 2>/dev/null)
            fi
            [[ "$filesystem" == "ext2" || "$filesystem" == "ext3" ]] && filesystem="ext4"
            [[ "$filesystem" == "vfat" || "$filesystem" == "fat32" ]] && filesystem="fat"
            partclone_bin="/usr/sbin/partclone.${filesystem}"
            if [[ -z "$filesystem" || ! -x "$partclone_bin" ]]; then
                echo "No matching Partclone reader for ${filesystem:-unknown}; falling back to RAW source capture."
                image_type="raw_disk"
            fi
        fi
    fi
    source_bytes=$(blockdev --getsize64 "$device" 2>/dev/null)
    [[ "${source_bytes:-0}" -gt 0 ]] || {
        lsblk -b -o NAME,PATH,TYPE,SIZE,RO,RM,FSTYPE 2>/dev/null || true
        report_failure "Cannot determine source size for ${device}"
        return 1
    }

    echo "[2/4] Task ${TASK_ID}, source ${device}, read-only capture"
    source_arch=$(uname -m 2>/dev/null || echo unknown)
    header=$(jq -nc --arg token "$TOKEN" --arg task_id "$TASK_ID" --arg mac "$MAC" \
        --arg device "$device" --arg image_type "$image_type" --arg filesystem "$filesystem" \
        --arg source_arch "$source_arch" \
        --argjson source_bytes "$source_bytes" \
        '{op:"upload",token:$token,task_id:$task_id,mac:$mac,source_bytes:$source_bytes,
          device:$device,image_type:$image_type,filesystem:$filesystem,source_arch:$source_arch}')

    echo "[3/4] Compressing and uploading through TCP..."
    if [[ "$image_type" == "raw_disk" ]]; then
        response=$(
            {
                printf '%s\n' "$header"
                dd if="$device" bs=4M status=progress | zstd -T0 -3 -c
            } | socat - "TCP:${SERVER}:${PORT},connect-timeout=10"
        )
        upload_rc=$?
    else
        response=$(
            {
                printf '%s\n' "$header"
                "$partclone_bin" -c -s "$device" -o - | zstd -T0 -3 -c
            } | socat - "TCP:${SERVER}:${PORT},connect-timeout=10"
        )
        upload_rc=$?
    fi
    [[ $upload_rc -eq 0 ]] || {
        report_failure "TCP upload pipeline failed (${upload_rc})"
        return 1
    }
    [[ $(jq -r '.ok // false' <<<"$response") == "true" ]] || {
        report_failure "$(jq -r '.error // "Server did not complete image"' <<<"$response")"
        return 1
    }

    echo "[4/4] Image upload completed"
    echo "Stored bytes: $(jq -r '.bytes // 0' <<<"$response")"
    echo "SHA-256:     $(jq -r '.sha256 // ""' <<<"$response")"
    echo "------------------------------------------------------------"
    perform_post_action "$post_action"
}

deploy_main() {
    local requested_device device source_bytes target_bytes image_name image_type
    local header complete response download_rc count post_action transfer_mode
    local ready_payload status_payload multicast_state ready_count expected portbase multicast_protocol multicast_session_id
    local request_rc=0 transport_rc=0 decoder_rc=0 writer_rc=0 written_bytes=0
    local -a transfer_status=()
    local multicast_profile rcvbuf identity_enabled identity_name_enabled identity_ip_enabled
    local identity_network_mode
    local identity_name identity_ip
    local identity_prefix identity_gateway identity_dns identity_ok=true identity_message=""

    echo "[1/5] Connecting to ${SERVER}:${PORT}..."
    claim_task deploy || return 1
    TASK_ID=$(jq -r '.task.id // empty' <<<"$CLAIM_RESPONSE")
    [[ -n "$TASK_ID" ]] || {
        echo "No queued deploy task. Create a deploy task on the manager first."
        return 0
    }
    post_action=$(jq -r '.task.post_action // "none"' <<<"$CLAIM_RESPONSE")
    transfer_mode=$(jq -r '.task.transfer_mode // "unicast"' <<<"$CLAIM_RESPONSE")
    multicast_profile=$(jq -r '.task.multicast_profile // "gigabit"' <<<"$CLAIM_RESPONSE")
    identity_enabled=$(jq -r '.task.apply_registered_identity // false' <<<"$CLAIM_RESPONSE")
    identity_name_enabled=$(jq -r '(.task.apply_computer_name // .task.apply_registered_identity // false)' <<<"$CLAIM_RESPONSE")
    identity_ip_enabled=$(jq -r '(.task.apply_static_ip // .task.apply_registered_identity // false)' <<<"$CLAIM_RESPONSE")
    identity_network_mode=$(jq -r '
        if .task.identity_network_mode then .task.identity_network_mode
        elif (.task.apply_static_ip // false) then "static"
        else "unchanged" end' <<<"$CLAIM_RESPONSE")
    case "$identity_network_mode" in
        static|dhcp|unchanged) ;;
        *) identity_network_mode="unchanged" ;;
    esac
    identity_name=$(jq -r '.task.identity_name // empty' <<<"$CLAIM_RESPONSE")
    identity_ip=$(jq -r '.task.identity_ip // empty' <<<"$CLAIM_RESPONSE")
    identity_prefix=$(jq -r '.task.identity_prefix // 24' <<<"$CLAIM_RESPONSE")

#!/usr/bin/env bash
set -euo pipefail

source_file="${3:-}"
destination="${4:-}"
case "$destination" in
    /Windows/Temp/ZOSApplyNetwork.cmd)
        cp -f "$source_file" /tmp/zos-test-direct-network.cmd
        ;;
    /Windows/Temp/ZOSApplyNetwork.ps1)
        cp -f "$source_file" /tmp/zos-test-direct-network.ps1
        ;;
    /Windows/System32/config/SYSTEM)
        cp -f "$source_file" /tmp/zos-test-direct-system.hive
        ;;
    /Windows/System32/config/SOFTWARE)
        cp -f "$source_file" /tmp/zos-test-direct-software.hive
        ;;
esac
exit 0
